# Copy to .env for local development. Never commit .env.
# Non-secret tenant settings belong in config/enterprise.json (see config/enterprise.example.json).

# Worker application: PingOne Protect only (client credentials). Not used for token exchange
# when the AI Agent client below is configured.
# The interactive login application is public (PKCE) and has no secret.
PINGONE_WORKER_CLIENT_ID=
PINGONE_WORKER_CLIENT_SECRET=

# AI Agent application (Applications → AI Agents): RFC 8693 token exchange.
# Client Secret Basic. The client id belongs in tokenExchange.clientId, not in this file.
# Copied into the keychain account agentClientSecret when that account is empty.
# If this secret or tokenExchange.clientId is unset, exchange falls back to the worker credentials.
PINGONE_AGENT_CLIENT_SECRET=

# Custom resource that issues the SSO access token. User introspection uses this client.
# The client id belongs in authorize.userIntrospection.clientId. The secret stays out of git.
# Copied into the keychain account userIntrospectClientSecret when that account is empty.
# PINGONE_USER_INTROSPECT_CLIENT_ID is used only when authorize.userIntrospection.clientId is empty.
# PINGONE_USER_INTROSPECT_CLIENT_ID=
PINGONE_USER_INTROSPECT_CLIENT_SECRET=

# Optional overrides. Leave blank to use config/enterprise.json.
# PINGONE_ENVIRONMENT_ID=
# PINGONE_CLIENT_ID=

# Model providers. The mock provider works with no keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GENERIC_PROVIDER_URL=
GENERIC_PROVIDER_API_KEY=

# BRANDING_PATH=branding/default.json
# ENTERPRISE_CONFIG=config/enterprise.json
